NODE_ENV=development
DEV_PASSWORD_RESET=false
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/peopledesk
JWT_SECRET=replace-with-a-unique-random-secret-minimum-32-chars
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
ADMIN_NAME=PeopleDesk Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
HR_NAME=PeopleDesk HR
HR_EMAIL=hr@example.com
HR_PASSWORD=change-this-hr-password
# Set per employee when running npm run create:employee-user.
EMPLOYEE_EMAIL=
EMPLOYEE_PASSWORD=
DEMO_EMPLOYEE_PASSWORD=Demo-Employee-123
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=PeopleDesk <no-reply@example.com>
# Production only: number of reverse-proxy hops in front of the app (Render/Railway = 1).
# TRUST_PROXY=1
