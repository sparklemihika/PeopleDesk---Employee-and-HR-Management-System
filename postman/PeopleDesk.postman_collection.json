            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Taylor Kim\",\n  \"email\": \"taylor.kim@example.com\",\n  \"position\": \"Product Designer\",\n  \"department\": \"Design\",\n  \"stage\": \"Applied\"\n}", "options": { "raw": { "language": "json" } } },
